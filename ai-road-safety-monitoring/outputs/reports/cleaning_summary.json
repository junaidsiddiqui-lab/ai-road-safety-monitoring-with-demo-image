  "steps": [
    {
      "problem": "Whitespace and text tokens such as 'Data missing or out of range' hide real missing values",
      "method": "Stripped text and replaced tokens with NaN",
      "why": "Missing values must be recognised before they can be analysed"
    },
    {
      "problem": "Coded columns use -1 for 'data missing or out of range'",
      "method": "Replaced -1 with NaN in coded columns",
      "why": "-1 is not a real category; treating it as a number would distort statistics",
      "values_replaced": 253852
    },
    {
      "problem": "Duplicate records inflate counts and can leak between train/test sets",
      "method": "Dropped exact duplicate rows, then repeated accident_index values (keep first)",
      "why": "accident_index uniquely identifies an accident record",
      "full_duplicates": 0,
      "duplicate_index": 0
    },
    {
      "problem": "Dates, times and counts are stored as text",
      "method": "Parsed dates (day-first) and HH:MM times, coerced numbers",
      "why": "Needed for time features; unparseable values become NaN instead of crashing",
      "unparsable_dates": 0,
      "unparsable_times": 0
    },
    {
      "problem": "Coordinates outside the valid range",
      "method": "Set to NaN",
      "why": "Impossible values are errors, not outliers",
      "coordinates_invalid": 0
    },
    {
      "problem": "Extreme counts (many vehicles/casualties) found with the 1.5xIQR rule",
      "method": "Kept the rows; reduced skew with a log1p transform inside the modelling pipeline",
      "why": "Large multi-vehicle crashes are real events, and they are the rare serious ones we care about",
      "outliers": {
        "number_of_vehicles": {
          "lower": -0.5,
          "upper": 3.5,
          "count": 1939,
          "max": 17.0
        },
        "number_of_casualties": {
          "lower": 1.0,
          "upper": 1.0,
          "count": 18208,
          "max": 142.0
        },
        "speed_limit": {
          "lower": 15.0,
          "upper": 55.0,
          "count": 18309,
          "max": 70.0
        }
      }
    },
    {
      "problem": "Raw date/time cannot be used directly by models",
      "method": "Created hour, month, weekday, weekend/rush-hour/night flags and cyclic hour_sin/hour_cos",
      "why": "Hour 23 and hour 0 are neighbours; the cyclic encoding preserves that"
    },
    {
      "problem": "Severity has three levels (1 fatal, 2 serious, 3 slight) and fatal is very rare",
      "method": "Binary target severe = fatal or serious",
      "why": "Keeps enough positive cases to learn from; rows without severity are unusable for supervised learning",
      "rows_dropped_no_target": 0
    },
    {
      "problem": "Columns with more than 50% missing values carry too little information",
      "method": "Dropped them (rows kept)",
      "why": "Rows with some missing fields are retained; remaining gaps are imputed later inside the pipeline",
      "dropped_columns": [
        "local_authority_district",
        "special_conditions_at_site"
      ]
    }
  ],
